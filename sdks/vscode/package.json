{
  "name": "hypercode",
  "displayName": "HyperCode",
  "description": "%hypercode.description%",
  "version": "1.18.30",
  "publisher": "sst-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hypercode",
    "ai",
    "assistant",
    "sessions",
    "remote-ssh"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:hypercode.sessions",
    "onView:hypercode.sessionView",
    "onView:hypercode.subagents",
    "onCommand:hypercode.refresh",
    "onCommand:hypercode.newSession",
    "onCommand:hypercode.openSession",
    "onCommand:hypercode.renameSession",
    "onCommand:hypercode.archiveSession",
    "onCommand:hypercode.shareSession",
    "onCommand:hypercode.unshareSession",
    "onCommand:hypercode.openOutput",
    "onCommand:hypercode.openSettings",
    "onCommand:hypercode.checkEnvironment",
    "onCommand:hypercode.refreshWorkspaceSessions",
    "onCommand:hypercode.openWorkspaceInBrowser",
    "onCommand:hypercode.restartWorkspaceServer",
    "onCommand:hypercode.quickNewSession",
    "onCommand:hypercode.askSelection",
    "onCommand:hypercode.askCurrentFile",
    "onCommand:hypercode.askExplorerFiles",
    "onCommand:hypercode.searchWorkspaceSessions",
    "onCommand:hypercode.clearWorkspaceSessionSearch",
    "onCommand:hypercode.manageSessionTags",
    "onCommand:hypercode.filterWorkspaceSessionsByTag",
    "onCommand:hypercode.clearWorkspaceTagFilter",
    "onCommand:hypercode.copyImagePreview",
    "onCommand:hypercode.saveImagePreview",
    "onWebviewPanel:hypercode.session"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypercode",
          "title": "HyperCode",
          "icon": "media/hypercode.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "hypercode-secondary",
          "title": "HyperCode",
          "icon": "media/hypercode.svg"
        }
      ]
    },
    "views": {
      "hypercode": [
        {
          "id": "hypercode.sessions",
          "name": "%hypercode.view.sessions%"
        },
        {
          "id": "hypercode.todo",
          "name": "%hypercode.view.todo%",
          "type": "webview"
        },
        {
          "id": "hypercode.diff",
          "name": "%hypercode.view.modifiedFiles%",
          "type": "webview"
        },
        {
          "id": "hypercode.subagents",
          "name": "%hypercode.view.subagents%",
          "type": "webview"
        }
      ],
      "hypercode-secondary": [
        {
          "id": "hypercode.sessionView",
          "name": "%hypercode.view.session%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hypercode.refresh",
        "title": "%hypercode.command.refresh%",
        "shortTitle": "%hypercode.command.refresh.short%",
        "icon": "$(refresh)"
      },
      {
        "command": "hypercode.newSession",
        "title": "%hypercode.command.newSession%",
        "shortTitle": "%hypercode.command.newSession.short%",
        "icon": "$(add)"
      },
      {
        "command": "hypercode.openOutput",
        "title": "%hypercode.command.openOutput%"
      },
      {
        "command": "hypercode.openLicenseFile",
        "title": "%hypercode.command.openLicenseFile%"
      },
      {
        "command": "hypercode.openSettings",
        "title": "%hypercode.command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "hypercode.checkEnvironment",
        "title": "%hypercode.command.checkEnvironment%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "hypercode.copyImagePreview",
        "title": "%hypercode.command.copyImage%"
      },
      {
        "command": "hypercode.saveImagePreview",
        "title": "%hypercode.command.saveImage%"
      },
      {
        "command": "hypercode.refreshWorkspaceSessions",
        "title": "%hypercode.command.refreshWorkspaceSessions%",
        "shortTitle": "%hypercode.command.refresh.short%",
        "icon": "$(refresh)"
      },
      {
        "command": "hypercode.openWorkspaceInBrowser",
        "title": "%hypercode.command.openWorkspaceInBrowser%",
        "shortTitle": "%hypercode.command.openWorkspaceInBrowser.short%",
        "icon": "$(globe)"
      },
      {
        "command": "hypercode.openSession",
        "title": "%hypercode.command.openSession%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "hypercode.renameSession",
        "title": "%hypercode.command.renameSession%",
        "icon": "$(edit)"
      },
      {
        "command": "hypercode.archiveSession",
        "title": "%hypercode.command.archiveSession%",
        "icon": "$(archive)"
      },
      {
        "command": "hypercode.shareSession",
        "title": "%hypercode.command.shareSession%",
        "icon": "$(link)"
      },
      {
        "command": "hypercode.unshareSession",
        "title": "%hypercode.command.unshareSession%",
        "icon": "$(unlock)"
      },
      {
        "command": "hypercode.restartWorkspaceServer",
        "title": "%hypercode.command.restartWorkspaceServer%",
        "shortTitle": "%hypercode.command.restartWorkspaceServer.short%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "hypercode.quickNewSession",
        "title": "%hypercode.command.quickNewSession%",
        "shortTitle": "HyperCode",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "hypercode.askSelection",
        "title": "%hypercode.command.askSelection%"
      },
      {
        "command": "hypercode.askCurrentFile",
        "title": "%hypercode.command.askCurrentFile%"
      },
      {
        "command": "hypercode.askExplorerFiles",
        "title": "%hypercode.command.askExplorerFiles%"
      },
      {
        "command": "hypercode.searchWorkspaceSessions",
        "title": "%hypercode.command.searchWorkspaceSessions%",
        "icon": "$(search)"
      },
      {
        "command": "hypercode.clearWorkspaceSessionSearch",
        "title": "%hypercode.command.clearWorkspaceSessionSearch%",
        "icon": "$(close)"
      },
      {
        "command": "hypercode.manageSessionTags",
        "title": "%hypercode.command.manageSessionTags%",
        "icon": "$(tag)"
      },
      {
        "command": "hypercode.filterWorkspaceSessionsByTag",
        "title": "%hypercode.command.filterWorkspaceSessionsByTag%",
        "icon": "$(tag)"
      },
      {
        "command": "hypercode.clearWorkspaceTagFilter",
        "title": "%hypercode.command.clearWorkspaceTagFilter%",
        "icon": "$(close)"
      }
    ],
    "configuration": {
      "title": "HyperCode",
      "properties": {
        "hypercode.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "%hypercode.setting.showThinking%",
          "scope": "machine-overridable"
        },
        "hypercode.showInternals": {
          "type": "boolean",
          "default": false,
          "description": "%hypercode.setting.showInternals%",
          "scope": "machine-overridable"
        },
        "hypercode.diffMode": {
          "type": "string",
          "default": "unified",
          "enum": [
            "unified",
            "split"
          ],
          "description": "%hypercode.setting.diffMode%",
          "scope": "machine-overridable"
        },
        "hypercode.compactSkillInvocations": {
          "type": "boolean",
          "default": true,
          "description": "%hypercode.setting.compactSkillInvocations%",
          "scope": "machine-overridable"
        },
        "hypercode.showSkillsInSlashAutocomplete": {
          "type": "boolean",
          "default": false,
          "description": "%hypercode.setting.showSkillsInSlashAutocomplete%",
          "scope": "machine-overridable"
        },
        "hypercode.panelTheme": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "codex",
            "claude"
          ],
          "description": "%hypercode.setting.panelTheme%",
          "scope": "machine-overridable"
        },
        "hypercode.panelColorScheme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "nocturne",
            "orchid",
            "verdant",
            "solar",
            "graphite",
            "ember"
          ],
          "description": "%hypercode.setting.panelColorScheme%",
          "scope": "machine-overridable"
        },
        "hypercode.httpProxy": {
          "type": "string",
          "default": "",
          "description": "%hypercode.setting.httpProxy%",
          "scope": "machine-overridable"
        },
        "hypercode.cliPath": {
          "type": "string",
          "default": "",
          "description": "%hypercode.setting.cliPath%",
          "scope": "machine-overridable"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "hypercode.quickNewSession",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "hypercode.askSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "navigation@1"
        },
        {
          "command": "hypercode.askCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "hypercode.askExplorerFiles",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "hypercode.copyImagePreview",
          "when": "webviewId == 'hypercode.session' && webviewSection == 'imagePreview'",
          "group": "navigation@1"
        },
        {
          "command": "hypercode.saveImagePreview",
          "when": "webviewId == 'hypercode.session' && webviewSection == 'imagePreview'",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "hypercode.openSettings",
          "when": "view == hypercode.sessions",
          "group": "navigation@99"
        }
      ],
      "view/item/context": [
        {
          "command": "hypercode.newSession",
          "when": "view == hypercode.sessions && (viewItem == workspace || viewItem == workspace-searching || viewItem == workspace-tag-filtered || viewItem == workspace-filtered)",
          "group": "inline@1"
        },
        {
          "command": "hypercode.searchWorkspaceSessions",
          "when": "view == hypercode.sessions && (viewItem == workspace || viewItem == workspace-searching || viewItem == workspace-tag-filtered || viewItem == workspace-filtered)",
          "group": "inline@2"
        },
        {
          "command": "hypercode.refreshWorkspaceSessions",
          "when": "view == hypercode.sessions && (viewItem == workspace || viewItem == workspace-searching || viewItem == workspace-tag-filtered || viewItem == workspace-filtered)",
          "group": "inline@3"
        },
        {
          "command": "hypercode.openWorkspaceInBrowser",
          "when": "view == hypercode.sessions && (viewItem == workspace || viewItem == workspace-searching || viewItem == workspace-tag-filtered || viewItem == workspace-filtered)",
          "group": "inline@4"
        },
        {
          "command": "hypercode.filterWorkspaceSessionsByTag",
          "when": "view == hypercode.sessions && (viewItem == workspace || viewItem == workspace-searching || viewItem == workspace-tag-filtered || viewItem == workspace-filtered)",
          "group": "inline@5"
        },
        {
          "command": "hypercode.clearWorkspaceSessionSearch",
          "when": "view == hypercode.sessions && (viewItem == workspace-searching || viewItem == workspace-filtered)",
          "group": "inline@6"
        },
        {
          "command": "hypercode.clearWorkspaceTagFilter",
          "when": "view == hypercode.sessions && (viewItem == workspace-tag-filtered || viewItem == workspace-filtered)",
          "group": "inline@7"
        },
        {
          "command": "hypercode.renameSession",
          "when": "view == hypercode.sessions && (viewItem == session || viewItem == session-shared)",
          "group": "inline@1"
        },
        {
          "command": "hypercode.shareSession",
          "when": "view == hypercode.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "hypercode.unshareSession",
          "when": "view == hypercode.sessions && viewItem == session-shared",
          "group": "inline@2"
        },
        {
          "command": "hypercode.archiveSession",
          "when": "view == hypercode.sessions && (viewItem == session || viewItem == session-shared)",
          "group": "inline@3"
        },
        {
          "command": "hypercode.manageSessionTags",
          "when": "view == hypercode.sessions && (viewItem == session || viewItem == session-shared)",
          "group": "inline@4"
        },
        {
          "command": "hypercode.clearWorkspaceSessionSearch",
          "when": "view == hypercode.sessions && viewItem == clear-search",
          "group": "inline@1"
        },
        {
          "command": "hypercode.clearWorkspaceTagFilter",
          "when": "view == hypercode.sessions && viewItem == clear-tag-filter",
          "group": "inline@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hypercode.quickNewSession",
        "title": "%hypercode.keybinding.run%",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "hypercode.newSession",
        "title": "%hypercode.keybinding.run%",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "hypercode.askCurrentFile",
        "title": "%hypercode.command.askCurrentFile%",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "dev": "node esbuild.js --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "bunx tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "check-types": "bunx tsc --noEmit",
    "lint": "echo lint skipped for migrated VS Code UI",
    "test": "vscode-test"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
