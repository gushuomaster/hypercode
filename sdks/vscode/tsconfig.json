{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@opencode-ai/sdk/v2/client": ["../../packages/sdk/js/src/v2/client.ts"],
      "@opencode-ai/sdk/v2/*": ["../../packages/sdk/js/src/v2/*"]
    },
    "sourceMap": true,
    "outDir": "dist",
    "types": ["node", "vscode"],
    "typeRoots": ["./node_modules/@types"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/test", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
